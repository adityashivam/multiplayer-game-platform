{
  "type": "module",
  "name": "kaboom-fight",
  "version": "1.0.0",
  "description": "Multiplayer fighting game with Kaboom.js",
  "main": "server/platform-backend-server/server.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:dead-shift:browser": "node tests/browser/dead-shift.mjs",
    "test:touch-controls:browser": "node tests/browser/touch-layouts.mjs",
    "test:config:browser": "node tests/browser/config-layout.mjs",
    "test:orientation:browser": "node tests/browser/game-orientation.mjs",
    "test:presentation:browser": "node tests/browser/game-presentation.mjs",
    "test:voice:browser": "node tests/browser/voice-chat.mjs",
    "test:ludo:browser": "node tests/browser/ludo.mjs",
    "test:sky-dash:browser": "node tests/browser/sky-dash.mjs",
    "test:riftball:browser": "node tests/browser/riftball.mjs",
    "test:room-start:browser": "node tests/browser/room-start.mjs",
    "test:multiplayer:browser": "node tests/browser/multiplayer-latency.mjs",
    "net:probe": "node scripts/network-probe.mjs",
    "start": "node server/platform-backend-server/server.js",
    "dev": "node --watch server/platform-backend-server/server.js",
    "platform:dev": "vite --config public/platform/vite.config.js",
    "platform:build": "vite build --config public/platform/vite.config.js",
    "platform:preview": "vite preview --config public/platform/vite.config.js",
    "build:msgpack": "esbuild node_modules/socket.io-msgpack-parser/index.js --bundle --format=esm --outfile=public/platform/frontend-engine/msgpackParser.js --platform=browser --minify",
    "build:dead-shift": "esbuild public/games/dead-shift/main.js --bundle --format=esm --target=es2020 --external:/platform/* --outfile=public/games/dead-shift/dist/main.js --minify",
    "build:sky-dash": "esbuild public/games/sky-dash/main.js --bundle --format=esm --target=es2020 --external:/platform/* --outfile=public/games/sky-dash/dist/main.js --minify",
    "build:riftball": "esbuild public/games/riftball/main.js --bundle --format=esm --target=es2020 --external:/platform/* --outfile=public/games/riftball/dist/main.js --minify",
    "build:ludo": "esbuild public/games/ludo/main.js --bundle --format=esm --target=es2020 --external:/platform/* --outfile=public/games/ludo/dist/main.js --minify",
    "build:edgeout": "esbuild public/games/edgeout/main.js public/games/edgeout/practice.js --bundle --format=esm --target=es2020 --external:/platform/* --outdir=public/games/edgeout/dist --minify",
    "build": "npm run build:msgpack && npm run build:dead-shift && npm run build:sky-dash && npm run build:riftball && npm run build:ludo && npm run build:edgeout && npm run platform:build",
    "postinstall": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.18.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "socket.io": "^4.8.0",
    "socket.io-msgpack-parser": "^3.0.2",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.2",
    "sass": "^1.97.1",
    "vite": "^7.3.0",
    "ws": "8.17.1"
  }
}
